@model Product
@{
    // Динамические классы и состояния (доп. задание, сложный уровень — из предыдущей практики)
    var borderClass = Model.Stock == 0 ? "border-danger" : (Model.DiscountPercent > 30 ? "border-success" : "");
    var extraShadow = Model.IsHit ? "shadow-sm" : "";
}

<div class="col-12 col-md-6 col-lg-4 product-col">
    <div class="card h-100 product-card @borderClass @extraShadow">
        <img src="@Model.ImageUrl" class="card-img-top img-fluid" alt="@Model.Name">
        <div class="card-body d-flex flex-column">

            <div class="mb-2">
                @if (Model.IsHit)
                {
                    <span class="badge bg-danger">Хит</span>
                }
                @if (Model.DiscountPercent > 30)
                {
                    <span class="badge bg-success">Большая скидка</span>
                }
                else if (Model.HasDiscount)
                {
                    <span class="badge bg-warning text-dark">Скидка</span>
                }
                @if (Model.Stock == 0)
                {
                    <span class="badge bg-secondary">Нет в наличии</span>
                }
            </div>

            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text text-muted small">@Model.Description</p>

            @* --- Адаптивная таблица цен (доп. задание, лёгкий уровень) --- *@
            <table class="table table-borderless table-sm price-table mb-2">
                <tbody>
                    @if (Model.HasDiscount)
                    {
                        <tr>
                            <td class="text-muted">Обычная цена</td>
                            <td class="text-end text-decoration-line-through text-muted">
                                @Model.OldPrice!.Value.ToString("C0")
                            </td>
                        </tr>
                    }
                    <tr>
                        <td class="fw-semibold">Цена</td>
                        <td class="text-end fs-5 fw-bold text-primary">@Model.Price.ToString("C0")</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-auto">
                @* Кнопка с data-product-id — обрабатывается через AJAX в cart.js.
                   type="button" (не submit), поэтому без JS кнопка просто ничего не делает —
                   это сознательный компромисс задания: AJAX-корзина требует включённого JS. *@
                <button type="button"
                        class="btn btn-primary w-100 add-to-cart"
                        data-product-id="@Model.Id"
                        data-product-name="@Model.Name"
                        @(Model.Stock == 0 ? "disabled" : "")>
                    В корзину
                </button>
            </div>
        </div>
    </div>
</div>
